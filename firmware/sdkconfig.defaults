# Pixelia – Grundkonfiguration für ESP32-8048S050C_I (ESP32-S3 N16R8)
# Nur bewusste Abweichungen vom ESP-IDF-Standard. Begründungen im Projektplan (4.1, 4.2, 4.9, 4.10).

CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB, Quad-SPI (laut eFuse), 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Eigene Partitionstabelle (A/B-Update, LittleFS, Core-Dump)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU 240 MHz, Leistung vor Größe
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: 8 MB Octal im Chip (ESP32-S3R8), 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Programmcode und Konstanten beim Start ins PSRAM spiegeln: Flash-Schreiben hält das System nicht an
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Datencache mit 64-Byte-Zeilen (schnellere PSRAM-Zugriffe)
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Display: RGB-Interrupt läuft auch bei abgeschaltetem Cache (kein Flackern bei Flash-Zugriffen)
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# A/B-Updates mit Rückfall auf die alte Version
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Absturzberichte als ELF-Core-Dump in die eigene Partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# FreeRTOS: 1-ms-Takt, Laufzeitstatistik für die CPU-Last pro Kern
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Watchdog: ein Hänger löst einen Neustart aus (im Probelauf eines Updates folgt dann der Rückfall, 4.10)
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# WLAN und Netzwerk (0.2.x): alles auf Kern 0, Puffer möglichst im PSRAM (interner RAM bleibt für das Display)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MDNS_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_LOCAL_HOSTNAME="Pixelia"
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Webserver mit WebSocket (Live-Status); lange Kopfzeilen (Captive-Portal-Abfragen, Browser-Kennungen)
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

# TCP: größeres Empfangsfenster (32 KB statt 5,7 KB) und SACK. Mit nur 4 Paketen im Fenster endet jeder
# Paketverlust im WLAN in immer längeren Wartezeiten (gemessen: Update-Upload blieb bei -71 dBm stehen).
# Die Puffer liegen dank SPIRAM_TRY_ALLOCATE_WIFI_LWIP im PSRAM.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_SACK_OUT=y
